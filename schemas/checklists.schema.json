{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Per-role requirement checklists (eval/checklists.json)",
  "description": "Optional requirement lists beside today's fit. Rows come from merged extraction reads; marks become votes and a verdict.",
  "type": "object",
  "required": ["schema_version", "roles"],
  "additionalProperties": false,
  "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
  "properties": {
    "schema_version": {"const": 1},
    "roles": {
      "type": "object",
      "additionalProperties": {"$ref": "#/definitions/role_entry"}
    }
  },
  "definitions": {
    "extension": {
      "description": "Extension field: any key starting x_ holds data the engine never reads."
    },
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "strength": {"enum": ["must", "should"]},
    "row_type": {
      "enum": ["licence", "eligibility", "condition", "credential", "experience", "skill", "soft_skill", "domain"]
    },
    "verdict": {"enum": ["met", "partly", "not_shown", "unknown", "not_applicable"]},
    "read_row": {
      "type": "object",
      "required": ["text", "strength", "type", "inferred", "applies"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]+$"},
        "text": {"type": "string", "minLength": 1},
        "strength": {"$ref": "#/definitions/strength"},
        "type": {"$ref": "#/definitions/row_type"},
        "inferred": {"type": "boolean"},
        "applies": {"type": "string", "minLength": 1}
      }
    },
    "row": {
      "type": "object",
      "required": ["id", "text", "strength", "type", "inferred", "applies"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
      "properties": {
        "id": {"type": "string", "pattern": "^R[0-9]+$"},
        "text": {"type": "string", "minLength": 1},
        "strength": {"$ref": "#/definitions/strength"},
        "type": {"$ref": "#/definitions/row_type"},
        "inferred": {"type": "boolean"},
        "applies": {"type": "string", "minLength": 1}
      }
    },
    "mark": {
      "type": "object",
      "required": ["verdict", "evidence", "quote"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
      "properties": {
        "verdict": {"$ref": "#/definitions/verdict"},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]+$"}
        },
        "quote": {"type": "string"}
      }
    },
    "role_entry": {
      "type": "object",
      "required": ["corrected", "rows", "votes"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
      "properties": {
        "corrected": {"type": "boolean"},
        "rows": {"type": "array", "items": {"$ref": "#/definitions/row"}},
        "votes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {"$ref": "#/definitions/verdict"}
          }
        },
        "reads": {
          "type": "array",
          "maxItems": 3,
          "items": {"type": "array", "items": {"$ref": "#/definitions/read_row"}}
        },
        "marks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": {"$ref": "#/definitions/mark"}
          }
        },
        "extracted_on": {"$ref": "#/definitions/date"},
        "extracted_by": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "agent": {"type": "string", "minLength": 1},
            "model": {"type": "string"}
          }
        }
      }
    }
  }
}
