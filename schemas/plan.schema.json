{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Campaign plan (campaign/plan.json)",
  "description": "North-star metrics, the action list (each one a bet with an expected gain, a chance and an effort), a backlog, and the experiments log. Priority = expected points x roles affected x chance / effort hours.",
  "type": "object",
  "required": ["schema_version", "north_star", "actions"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "updated_on": {"$ref": "#/definitions/date"},
    "principle": {"type": "string"},
    "max_active": {"type": "integer", "minimum": 1, "maximum": 20},
    "north_star": {"type": "array", "items": {"$ref": "#/definitions/metric"}},
    "actions": {"type": "array", "items": {"$ref": "#/definitions/action"}},
    "backlog": {"type": "array", "items": {"type": "string"}},
    "experiments_log": {"type": "array", "items": {"$ref": "#/definitions/experiment"}}
  },
  "definitions": {
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "metric": {
      "type": "object",
      "required": ["id", "name", "current", "target"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "current": {"type": "integer", "minimum": 0},
        "target": {"type": "integer", "minimum": 0},
        "evidence": {"type": "array", "items": {"type": "string", "pattern": "^E[0-9]{2,}$"}}
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "title", "status", "dimension", "effort_hours", "expected_points", "roles_affected", "chance", "done_when"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^A[0-9]{2,}$"},
        "title": {"type": "string", "minLength": 1},
        "why": {"type": "string"},
        "status": {"enum": ["todo", "doing", "done", "dropped"]},
        "owner": {"enum": ["you", "agent", "both"]},
        "dimension": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"]},
        "orgs": {"anyOf": [{"const": "all"}, {"type": "array", "items": {"type": "string"}}]},
        "gap_id": {"type": "string"},
        "strategy_ids": {"type": "array", "items": {"type": "string", "pattern": "^(SO|ST|WO|WT)[0-9]+$"}},
        "metric": {"type": "string", "description": "The north-star metric id this action should move."},
        "effort_hours": {"type": "number", "exclusiveMinimum": 0},
        "expected_points": {"type": "number", "minimum": 0, "description": "Fit points gained per affected role if it works."},
        "roles_affected": {"type": "integer", "minimum": 0},
        "chance": {"type": "number", "minimum": 0, "maximum": 1},
        "done_when": {"type": "string", "minLength": 1},
        "done_evidence": {"type": "string", "description": "A link, file path or email reference. Required before status can be done."},
        "added_on": {"$ref": "#/definitions/date"},
        "started_on": {"$ref": "#/definitions/date"},
        "finished_on": {"$ref": "#/definitions/date"},
        "draft": {"type": "string", "description": "Path to a draft in campaign/drafts/ for the person to send."},
        "notes": {"type": "string"}
      }
    },
    "experiment": {
      "type": "object",
      "required": ["date", "action_id", "result", "decision"],
      "additionalProperties": false,
      "properties": {
        "date": {"$ref": "#/definitions/date"},
        "action_id": {"type": "string"},
        "action": {"type": "string"},
        "result": {"type": "string"},
        "decision": {"enum": ["keep", "rework", "drop", "done"]},
        "why": {"type": "string"}
      }
    }
  }
}
