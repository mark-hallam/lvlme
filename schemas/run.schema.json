{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Scored run (eval/runs/<date>.json)",
  "description": "One deterministic scored run written by score.py: every role with its seven dimension scores, fit, bands and adjustments, plus best role per organisation, the gap leaderboard, the outlook and the verify-to-unlock questions.",
  "type": "object",
  "required": ["schema_version", "run_date", "rubric_version", "weights", "counts", "roles", "per_org", "gaps", "outlook", "verify_to_unlock", "warnings"],
  "additionalProperties": false,
  "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
  "properties": {
    "schema_version": {"const": 1},
    "run_date": {"$ref": "#/definitions/date"},
    "rubric_version": {"type": "string"},
    "goal": {"type": "string"},
    "weights": {"type": "object", "additionalProperties": {"type": "integer"}},
    "inputs_digest": {"type": "string"},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "roles": {"type": "array", "items": {"$ref": "#/definitions/role"}},
    "per_org": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {"type": "null"},
          {
            "type": "object",
            "required": ["role_id", "title", "fit", "interview_band", "offer_band"],
            "additionalProperties": false,
            "properties": {
              "role_id": {"type": "string"},
              "title": {"type": "string"},
              "fit": {"type": "number"},
              "fit_low": {"type": "number"},
              "fit_high": {"type": "number"},
              "interview_band": {"$ref": "#/definitions/band"},
              "offer_band": {"$ref": "#/definitions/band"}
            }
          }
        ]
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "dimension", "points_gain", "roles_affected"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "why": {"type": "string"},
          "dimension": {"$ref": "#/definitions/dimension"},
          "target_score": {"type": "integer", "minimum": 0, "maximum": 5},
          "points_gain": {"type": "number", "minimum": 0},
          "roles_affected": {"type": "integer", "minimum": 0},
          "kind": {"enum": ["show_it", "build_it"], "description": "Show it: the proof is missing (usually days). Build it: the skill is missing (usually weeks or months)."},
          "pool": {"enum": ["overall", "per_org"], "description": "Only written when config.json scoring.gap_pool is per_org."},
          "by_org": {
            "type": "object",
            "description": "With gap_pool per_org: the points and roles each organisation's pool adds.",
            "additionalProperties": {
              "type": "object",
              "required": ["points_gain", "roles_affected"],
              "additionalProperties": false,
              "properties": {"points_gain": {"type": "number", "minimum": 0}, "roles_affected": {"type": "integer", "minimum": 0}}
            }
          }
        }
      }
    },
    "outlook": {
      "type": "object",
      "required": ["band", "text"],
      "additionalProperties": false,
      "properties": {
        "band": {"enum": ["Almost none", "Very low", "Low", "Moderate", "Good", "Strong", "Not yet judged"]},
        "text": {"type": "string"},
        "reasons": {"type": "array", "items": {"type": "string"}},
        "judged_on": {"$ref": "#/definitions/date"}
      }
    },
    "verify_to_unlock": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question", "why", "source"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "why": {"type": "string"},
          "dimensions": {"type": "array", "items": {"$ref": "#/definitions/dimension"}},
          "source": {"enum": ["open_question", "unverified_evidence"]}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "definitions": {
    "extension": {"description": "Extension field: any key starting x_ holds data the engine never reads (for example a field from an older system). Kept as is."},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "dimension": {"enum": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"]},
    "band": {"enum": ["Almost none", "Very low", "Low", "Moderate", "Good", "Strong"]},
    "score": {
      "type": "object",
      "required": ["score", "raw", "evidence", "note"],
      "additionalProperties": false,
      "properties": {
        "score": {"type": "integer", "minimum": 0, "maximum": 5},
        "raw": {"type": "integer", "minimum": 0, "maximum": 5},
        "judgings": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 5}, "description": "D1, D2 and D4: each independent judging, before caps, when the factor was judged more than once. The score is their average (halves round down)."},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"},
        "capped": {"type": "string"},
        "evidence_fingerprint": {"type": "string", "description": "D1, D2 and D4: a short hash of the cited evidence (each id, its level and claim), to tell whether only the judge changed."},
        "judged_by": {"type": "string", "description": "The AI agent (and model) that judged this factor, when recorded."},
        "judge_changed": {
          "type": "object", "required": ["previous_score", "new_score", "previous_judge", "new_judge", "kept"],
          "additionalProperties": false,
          "description": "Only the judge changed and the evidence did not, so the previous score was kept.",
          "properties": {"previous_score": {"type": "integer", "minimum": 0, "maximum": 5},
                         "new_score": {"type": "integer", "minimum": 0, "maximum": 5},
                         "previous_judge": {"type": "string"}, "new_judge": {"type": "string"}, "kept": {"const": "previous"}}
        }
      }
    },
    "role": {
      "type": "object",
      "required": ["role_id", "org", "title", "family", "scores", "fit", "interview_band", "offer_band", "adjustments"],
      "additionalProperties": false,
      "patternProperties": {"^x_": {"$ref": "#/definitions/extension"}},
      "properties": {
        "role_id": {"type": "string"},
        "org": {"type": "string"},
        "title": {"type": "string"},
        "family": {"type": "string"},
        "locations": {"type": "array", "items": {"type": "string"}},
        "location_class": {"type": "string"},
        "url": {"type": ["string", "null"]},
        "scores": {
          "type": "object",
          "required": ["D1", "D2", "D3", "D4", "D5", "D6", "D7"],
          "additionalProperties": false,
          "properties": {
            "D1": {"$ref": "#/definitions/score"},
            "D2": {"$ref": "#/definitions/score"},
            "D3": {"$ref": "#/definitions/score"},
            "D4": {"$ref": "#/definitions/score"},
            "D5": {"$ref": "#/definitions/score"},
            "D6": {"$ref": "#/definitions/score"},
            "D7": {"$ref": "#/definitions/score"}
          }
        },
        "fit": {"type": "number", "minimum": 0, "maximum": 100, "description": "The average fit, from the averaged factor scores."},
        "fit_low": {"type": "number", "minimum": 0, "maximum": 100, "description": "The lowest fit the judgings allow: every judged factor at its lower judging. Equals fit when each factor was judged once."},
        "fit_high": {"type": "number", "minimum": 0, "maximum": 100, "description": "The highest fit the judgings allow: every judged factor at its higher judging. Equals fit when each factor was judged once."},
        "interview_band": {"$ref": "#/definitions/band"},
        "offer_band": {"$ref": "#/definitions/band"},
        "adjustments": {"type": "array", "items": {"type": "string"}},
        "judged": {"type": "boolean"},
        "awaiting_review": {"type": "array", "items": {"$ref": "#/definitions/dimension"}},
        "eligibility_blocked": {"type": "boolean"},
        "hard_requirement_lacking": {"type": "boolean"},
        "requires_heavy_coding": {"type": "boolean"},
        "reviewer_note": {"type": "string"}
      }
    }
  }
}
